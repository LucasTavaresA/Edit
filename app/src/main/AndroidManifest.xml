<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edit">
        <!--
            Every configuration change we can take ourselves is taken, because the alternative is
            the activity being rebuilt, and nothing can restore the open document: its descriptor
            and pieces do not fit a saved instance state, and no permission is held that would let
            the file be opened again. Nothing is read outside composition, so Compose sees the new
            configuration and lays out again on its own.
        -->
        <!--
            The keyboard must arrive as an inset and never as a shove. Left unsaid, the system
            picks per orientation, and panning slides the whole window up, taking the toolbar off
            the top of the screen. Resize makes the IME an inset the layout pays in the one place
            that should pay it.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
