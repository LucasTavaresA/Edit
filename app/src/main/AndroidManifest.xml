<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        No fullBackupContent: allowBackup="false" already stops every backup on Android 11 and
        below, where the extraction rules do not apply, so it would have nothing left to narrow.
    -->
    <application
        tools:ignore="DataExtractionRules"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edit">
        <!--
            Every configuration change we can take ourselves is taken, because the alternative is
            the activity being rebuilt, and nothing can restore the open document: its descriptor
            and pieces do not fit a saved instance state, and opening the file again, all a rebuild
            can do, loses the unsaved edits and cannot reach a file whose access ended with the
            process. Nothing is read outside composition, so Compose sees the new configuration
            and lays out again on its own.
        -->
        <!--
            The keyboard must arrive as an inset and never as a shove. Left unsaid, the system
            picks per orientation, and panning slides the whole window up, taking the toolbar off
            the top of the screen. Resize makes the IME an inset the layout pays in the one place
            that should pay it.
        -->
        <!--
            One Edit, holding every open file: another app handing a file over reaches the running
            one through onNewIntent and joins its list, rather than starting a copy in its own task.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
